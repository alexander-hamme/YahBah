# Database
DATABASE_URL=postgresql+psycopg://yahbah_app:change-me@localhost/yahbah

# Temporal
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=job-applications

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=900
# Model roles: defaults live in src/yahbah/config.py; uncomment to override.
# Keep CTX_* fixed per model, or Ollama reloads it.
# MODEL_DRIVER=
# CTX_DRIVER=
# MODEL_PROSE_VISION=
# CTX_PROSE_VISION=

# Safety
MIN_FIELD_CONFIDENCE=0.7
DUPLICATE_WINDOW_DAYS=31

# Gmail ingestion
GMAIL_CREDENTIALS_DIR=~/.config/yahbah/gmail
GMAIL_POLL_INTERVAL_SECONDS=7
GMAIL_POLL_TIMEOUT_SECONDS=300
GMAIL_LABEL_PARSED=YahBah/Parsed

# Artifacts
ARTIFACTS_DIR=./artifacts

# Prompts / known answers config
PROMPTS_PATH=config/prompts.yaml

# App
APP_ENV=dev
LOG_LEVEL=INFO
